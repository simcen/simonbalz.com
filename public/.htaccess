# Fehlerseite aus dem Build
ErrorDocument 404 /404.html

# www auf die Hauptadresse umleiten (HTTPS selbst wird im my.cyon eingestellt)
RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.simonbalz\.com$ [NC]
RewriteRule ^(.*)$ https://simonbalz.com/$1 [R=301,L]

# Von Astro erzeugte Dateien unter /_astro/ tragen einen Hash im Namen
# und dürfen deshalb ein Jahr im Cache bleiben. HTML bleibt kurzlebig.
<IfModule mod_headers.c>
  <FilesMatch "\.[A-Za-z0-9_-]{8}\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(woff2|png|webp)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
