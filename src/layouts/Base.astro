---
import '../styles/site.css';
import { site } from '../site';
import { homePath, type Dictionary, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  t: Dictionary;
  /** Auf false setzen für Seiten, die nicht in den Suchindex sollen (z. B. 404). */
  indexable?: boolean;
}

const { lang, t, indexable = true } = Astro.props;
const pageUrl = site.url + homePath[lang];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  url: pageUrl,
  inLanguage: lang,
  name: t.meta.title,
  mainEntity: {
    '@type': 'Person',
    '@id': `${site.url}/#simonbalz`,
    name: site.name,
    givenName: 'Simon',
    familyName: 'Balz',
    url: `${site.url}/`,
    image: `${site.url}/assets/simon-balz.webp`,
    jobTitle: site.jobTitle,
    description: t.meta.description,
    worksFor: { '@type': 'Organization', name: site.employer.name, url: site.employer.url },
    address: { '@type': 'PostalAddress', addressRegion: 'Bern', addressCountry: 'CH' },
    knowsAbout: t.meta.knowsAbout,
    knowsLanguage: ['de', 'en'],
    award: site.award,
    sameAs: [site.linkedin, site.github, site.twitter],
  },
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <meta name="author" content={site.name} />
    {
      indexable ? (
        <>
          <meta name="robots" content="index, follow, max-image-preview:large" />
          <link rel="canonical" href={pageUrl} />
          <link rel="alternate" hreflang="de" href={site.url + homePath.de} />
          <link rel="alternate" hreflang="en" href={site.url + homePath.en} />
          <link rel="alternate" hreflang="x-default" href={site.url + homePath.de} />
        </>
      ) : (
        <meta name="robots" content="noindex" />
      )
    }
    <meta name="google-site-verification" content={site.googleSiteVerification} />
    <link rel="me" href={site.linkedin} />
    <link rel="me" href={site.github} />
    <link rel="icon" type="image/png" href="/assets/favicon.png" />
    <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png" />
    <link rel="preload" href="/assets/archivo.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#0c1f24" />
    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:locale" content={t.meta.ogLocale} />
    <meta property="og:image" content={`${site.url}/assets/og-image.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="profile:first_name" content="Simon" />
    <meta property="profile:last_name" content="Balz" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content={site.twitterHandle} />
    {indexable && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
  </head>
  <body>
    <slot />
    <script is:inline>
      // Setzt die E-Mail-Links zusammen (siehe EmailLink.astro).
      document.querySelectorAll('a[data-m]').forEach(function (a) {
        var m = atob(a.dataset.m).split('').reverse().join('');
        a.href = 'mailto:' + m + (a.dataset.s ? '?subject=' + encodeURIComponent(a.dataset.s) : '');
        if (a.dataset.show) a.textContent = m;
      });
    </script>
  </body>
</html>
