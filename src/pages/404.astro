---
import Base from '../layouts/Base.astro';
import { dictionaries } from '../i18n';

const t = dictionaries.de;
const en = dictionaries.en;
---

<Base lang="de" t={t} indexable={false}>
  <main class="wrap" style="padding-block:18vh">
    <h1>
      <span>{t.notFound.title}</span>
    </h1>
    <p class="lead">{t.notFound.text} <span lang="en">{en.notFound.text}</span></p>
    <div class="actions">
      <a class="btn" href="/">{t.notFound.home}</a>
      <a class="textlink" href="/en/" lang="en">{en.notFound.home}</a>
    </div>
  </main>
</Base>
