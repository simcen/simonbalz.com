---
import EmailLink from './EmailLink.astro';
import { site } from '../site';
import type { Dictionary } from '../i18n';

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
---

<section class="wrap hero" id="top">
  <div class="hero-text">
    <h1>
      <span class="name">{t.hero.name}</span>
      <span>{t.hero.line1}</span>
      <span>{t.hero.line2}</span>
    </h1>
    <p class="lead">{t.hero.lead}</p>
    <div class="actions">
      <EmailLink class="btn">{t.hero.cta}</EmailLink>
      <a class="textlink secondary" href={site.linkedin} aria-label={t.hero.linkedin}>
        <span class="long">{t.hero.linkedin}</span><span class="short">LinkedIn</span>
      </a>
    </div>
  </div>
  <figure class="figure">
    <span class="shape-a"></span>
    <span class="shape-b"></span>
    <div class="portrait">
      <img src="/assets/simon-balz.webp" alt={t.meta.portraitAlt} width="600" height="768" fetchpriority="high" />
    </div>
  </figure>
</section>
