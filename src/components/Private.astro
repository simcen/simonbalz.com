---
import { privateIcons } from './icons';
import type { Dictionary } from '../i18n';

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
---

<section class="section private" id="privat">
  <div class="wrap split">
    <h2>{t.private.title}</h2>
    <div>
      <p>{t.private.text}</p>
      <div class="icons" aria-hidden="true">
        {privateIcons.map((icon) => <svg viewBox="0 0 56 56" set:html={icon} />)}
      </div>
    </div>
  </div>
</section>
