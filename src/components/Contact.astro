---
import EmailLink from './EmailLink.astro';
import { site } from '../site';
import type { Dictionary } from '../i18n';

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
---

<section class="section contact" id="kontakt">
  <div class="wrap">
    <h2>{t.contact.title}</h2>
    <EmailLink class="mail" showAddress>{t.contact.emailFallback}</EmailLink>
    <ul class="links">
      <li><a class="textlink" href={site.linkedin}>LinkedIn</a></li>
      <li><a class="textlink" href={site.github}>GitHub</a></li>
    </ul>
  </div>
</section>
